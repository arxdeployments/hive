# Backend runs standalone with:  uvicorn app.main:app --reload
# All settings have the RXHIVE_ prefix and are typed in app/core/config.py.

RXHIVE_DATABASE_URL=postgresql+asyncpg://rxhive:rxhive@localhost:5432/rxhive
RXHIVE_REDIS_URL=redis://localhost:6379/0

# 256-bit secret for JWT signing. Generate: openssl rand -hex 32
RXHIVE_SECRET_KEY=dev-only-secret-change-in-production

# Object storage (MinIO locally, S3 in cloud — same API)
RXHIVE_S3_ENDPOINT=http://localhost:9000
RXHIVE_S3_PUBLIC_ENDPOINT=http://localhost:9000
RXHIVE_S3_ACCESS_KEY=rxhive
RXHIVE_S3_SECRET_KEY=rxhive-dev
RXHIVE_S3_BUCKET=rxhive-attachments

# LiveKit (calls). Calls do not work at all without a reachable SFU —
# GET /api/health reports it as "livekit": connected|unreachable|not_configured.
RXHIVE_LIVEKIT_URL=ws://localhost:7880
# Only needed when RXHIVE_LIVEKIT_URL is a path the browser resolves (e.g.
# "/livekit" behind Caddy): the server-side address /api/health probes.
# RXHIVE_LIVEKIT_HEALTH_URL=http://livekit:7880
RXHIVE_LIVEKIT_API_KEY=devkey
RXHIVE_LIVEKIT_API_SECRET=devsecret-at-least-32-characters-long

# CORS: comma-separated exact origins (dev Vite server)
RXHIVE_CORS_ORIGINS=http://localhost:5173

# Cookies: set true when serving over HTTPS
RXHIVE_COOKIE_SECURE=false

# Seed super-admin (idempotent; used by `python -m app.seed`)
RXHIVE_SEED_SUPERADMIN_EMAIL=admin@rhythmrx.ai
RXHIVE_SEED_SUPERADMIN_PASSWORD=ChangeMe-Dev-Password1
