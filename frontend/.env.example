# Base URL of the API. Leave empty for same-origin (production behind Caddy,
# or the Vite dev proxy). Set only when the API runs on a different origin.
VITE_BACKEND_URL=

# LiveKit signal URL the browser connects to (defaults to the value the API
# returns from /api/calls/{id}/token, so usually leave unset).
VITE_LIVEKIT_URL=
