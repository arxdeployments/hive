# Copy to infra/.env and change every secret before `docker compose up`.

# --- Postgres ---
POSTGRES_DB=rxhive
POSTGRES_USER=rxhive
POSTGRES_PASSWORD=change-me-strong-password

# --- MinIO (object storage) ---
MINIO_ROOT_USER=rxhive
MINIO_ROOT_PASSWORD=change-me-strong-password

# --- LiveKit (calls) ---
LIVEKIT_API_KEY=rxhive-api
LIVEKIT_API_SECRET=change-me-32-chars-minimum-secret
# URL the *browser* uses to reach the LiveKit signal endpoint.
# Behind the bundled Caddy this is wss://<your-domain>/livekit (or ws://… for plain HTTP).
RXHIVE_LIVEKIT_PUBLIC_URL=/livekit

# --- API ---
# 256-bit secret for JWT signing. Generate: openssl rand -hex 32
RXHIVE_SECRET_KEY=change-me-openssl-rand-hex-32
# Comma-separated exact origins allowed for CORS (the site itself is always allowed).
RXHIVE_CORS_ORIGINS=
# Initial super-admin (created by the idempotent seed on first boot)
RXHIVE_SEED_SUPERADMIN_EMAIL=admin@rhythmrx.ai
RXHIVE_SEED_SUPERADMIN_PASSWORD=change-me-then-rotate-in-app
API_WORKERS=2

# Public base path the browser uses for presigned attachment URLs (Caddy route).
RXHIVE_S3_PUBLIC_ENDPOINT=/s3

# --- Caddy ---
# ":80" for plain HTTP (behind an external LB/tunnel), or your domain for auto-TLS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
