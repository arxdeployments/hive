# Copy to infra/.env and change every secret before `docker compose up`.

# --- Postgres ---
POSTGRES_DB=rxhive
POSTGRES_USER=rxhive
POSTGRES_PASSWORD=change-me-strong-password

# --- MinIO (object storage) ---
MINIO_ROOT_USER=rxhive
MINIO_ROOT_PASSWORD=change-me-strong-password

# --- LiveKit (calls) ---
# If you change LIVEKIT_API_KEY you must ALSO change `webhook.api_key` in
# infra/livekit.yaml and infra/livekit.prod.yaml. Those files are in git and
# cannot read this .env, and the SFU signs its webhooks with that key — if the
# two disagree, calls still work but the API rejects every room event with
# "Rejected LiveKit webhook: verification failed", and calls stop being finalized.
LIVEKIT_API_KEY=rxhive-api
LIVEKIT_API_SECRET=change-me-32-chars-minimum-secret
# URL the *browser* uses to reach the LiveKit signal endpoint.
# Behind the bundled Caddy this is wss://<your-domain>/livekit (or ws://… for plain HTTP).
RXHIVE_LIVEKIT_PUBLIC_URL=/livekit

# --- API ---
# 256-bit secret for JWT signing. Generate: openssl rand -hex 32
# The API REFUSES to boot in production with this placeholder or anything <32 chars.
RXHIVE_SECRET_KEY=change-me-openssl-rand-hex-32
# production | development. Production enforces real secrets, Secure cookies, no API docs.
RXHIVE_ENVIRONMENT=production
# Secure cookies (requires HTTPS). Leave true for any real deployment.
RXHIVE_COOKIE_SECURE=true
# Comma-separated exact origins for CORS. Empty = same-origin only (behind Caddy).
RXHIVE_CORS_ORIGINS=
# Web Push VAPID keys — generate with: docker compose run --rm api python -m app.tools.vapid
RXHIVE_VAPID_PUBLIC_KEY=
RXHIVE_VAPID_PRIVATE_KEY=
# Initial super-admin (created by the idempotent seed on first boot; then rotate in-app)
RXHIVE_SEED_SUPERADMIN_EMAIL=admin@rhythmrx.ai
RXHIVE_SEED_SUPERADMIN_PASSWORD=change-me-strong-then-rotate
API_WORKERS=2

# Public base path the browser uses for presigned attachment URLs (Caddy route).
RXHIVE_S3_PUBLIC_ENDPOINT=/s3

# --- Caddy ---
# ":80" for plain HTTP (behind an external LB/tunnel), or your domain for auto-TLS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
