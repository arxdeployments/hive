# Reverse proxy: one origin for web, API, WebSocket, object storage and LiveKit signal.
# SITE_ADDRESS=":80" for plain HTTP behind an external LB, or "chat.example.com" for automatic TLS.
{$SITE_ADDRESS}

encode gzip zstd

# API + WebSocket
handle /api/* {
	reverse_proxy api:8000
}
handle /ws* {
	reverse_proxy api:8000
}

# Presigned object-storage URLs (path-style: /s3/<bucket>/<key>?X-Amz-...)
#
# header_up Host is LOAD-BEARING, exactly as in Caddyfile.prod. SigV4 signs the
# Host header, and the API presigns against RXHIVE_S3_ENDPOINT=http://minio:9000,
# so the signature covers "minio:9000". Caddy otherwise forwards the browser's own
# Host (localhost), MinIO recomputes the signature over that and rejects it:
#
#   403 SignatureDoesNotMatch
#
# Which showed up as every sent image failing to render, since /api/media/{id}
# 307-redirects to this route. Must match the signed host and port exactly.
handle_path /s3/* {
	# The attachment bytes themselves, and the ONE response on this origin that
	# carries no security headers.
	#
	# app/main.py stamps nosniff, X-Frame-Options: DENY and Referrer-Policy on
	# every API response, and the SPA gets the same four plus a CSP from
	# frontend/nginx-security-headers.conf. This route reaches neither: it is
	# Caddy straight to object storage, so the response arrives with whatever the
	# store sends and nothing else.
	#
	# /api/media/* stamping them on its 307 does not help. Response headers do not
	# survive a redirect — the browser follows it and renders THIS response, which
	# is the one holding the file. (The comment in PdfViewer.jsx reasons from the
	# 307 carrying DENY; true of the redirect, not of what the browser ends up
	# displaying.)
	#
	# And this is user-uploaded content on the app's own origin, which is
	# deliberate rather than incidental: media has to be same-origin because CSP
	# is enforced against redirect targets and `img-src 'self'` blocks a
	# cross-origin one, so every attachment would fail to render.
	#
	# Nothing here is a live hole today. api/media.py resolves the Content-Type
	# from MIME_BY_EXT and falls back to application/octet-stream, and uploads are
	# unrestricted by extension ("any format may be sent") — so a .html or .svg
	# arrives as octet-stream, which browsers download rather than execute. That
	# allow-list is the entire barrier, and nosniff is what stops it being
	# load-bearing: one future entry for text/html or image/svg+xml, or a store or
	# CDN that rewrites the type, turns a stored file into a same-origin document
	# with nothing left in the way.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy minio:9000 {
		header_up Host minio:9000
	}
}

# LiveKit signal WebSocket
handle_path /livekit/* {
	reverse_proxy livekit:7880
}

# Frontend SPA
handle {
	reverse_proxy web:80
}
