# Production reverse proxy: ONE origin in front of the SPA, the API and the
# LiveKit signal websocket, with automatic TLS from Let's Encrypt.
#
# SITE_ADDRESS must be the real hostname (chat.example.com) whose A record
# points at the Elastic IP. Caddy needs :80 reachable for the HTTP-01 challenge
# and :443 for traffic. ":80" here would disable TLS — dev only, and it would
# also break auth, since RXHIVE_COOKIE_SECURE=true means the browser refuses to
# send the session cookies over plain HTTP.
#
# Keeps the dev Caddyfile's /s3 route, repointed from MinIO to S3: production has no
# MinIO container, and the browser fetches presigned URLs directly from S3.
# Attachments are still never public — /api/media/* verifies membership and only
# then redirects to a short-lived presigned URL.
{$SITE_ADDRESS}

encode gzip zstd

# API (REST + presign redirects)
handle /api/* {
	reverse_proxy api:8000
}

# LiveKit signal websocket only. Media does NOT pass through here — it is SRTP
# direct to the instance on UDP 50000-50100 (TCP 7881 as fallback).
# Attachments. /api/media/* authorises the request, then redirects here with a
# short-lived presigned URL. Proxying (rather than redirecting the browser
# straight to S3) keeps media same-origin, which is required because CSP is
# enforced against redirect targets — a cross-origin redirect is blocked by
# `img-src 'self'` and every attachment fails to render.
#
# header_up Host is load-bearing: SigV4 signs the Host header, and minio signs
# virtual-host style, so the upstream must see <bucket>.s3.<region>.amazonaws.com
# or S3 answers SignatureDoesNotMatch.
handle_path /s3/* {
	# The attachment bytes themselves: the one response on this origin that gets
	# its security headers HERE rather than inheriting them.
	#
	# app/main.py stamps nosniff, X-Frame-Options: DENY and Referrer-Policy on
	# every API response, and the SPA gets those plus a CSP from
	# frontend/nginx-security-headers.conf. This route reaches neither — it is
	# Caddy straight to object storage — so whatever is not declared in this block
	# is simply whatever the store chose to send. Hence the header directive below;
	# before it there was nothing.
	#
	# /api/media/* stamping them on its 307 does not help. Response headers do not
	# survive a redirect — the browser follows it and renders THIS response, which
	# is the one holding the file. (The comment in PdfViewer.jsx reasons from the
	# 307 carrying DENY; true of the redirect, not of what the browser ends up
	# displaying.)
	#
	# And this is user-uploaded content on the app's own origin, which is
	# deliberate rather than incidental: media has to be same-origin because CSP
	# is enforced against redirect targets and `img-src 'self'` blocks a
	# cross-origin one, so every attachment would fail to render.
	#
	# Nothing here is a live hole today. api/media.py resolves the Content-Type
	# from MIME_BY_EXT and falls back to application/octet-stream, and uploads are
	# unrestricted by extension ("any format may be sent") — so a .html or .svg
	# arrives as octet-stream, which browsers download rather than execute. That
	# allow-list is the entire barrier, and nosniff is what stops it being
	# load-bearing: one future entry for text/html or image/svg+xml, or a store or
	# CDN that rewrites the type, turns a stored file into a same-origin document
	# with nothing left in the way.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy https://{$S3_BUCKET_HOST} {
		header_up Host {$S3_BUCKET_HOST}
	}
}

handle_path /livekit/* {
	reverse_proxy livekit:7880
}

# Frontend SPA (nginx serving the built bundle)
handle {
	reverse_proxy web:80
}
