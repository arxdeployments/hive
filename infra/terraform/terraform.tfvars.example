# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
#   cd infra/terraform && cp terraform.tfvars.example terraform.tfvars
#   tofu init && tofu apply     (or terraform init && terraform apply)

# --- Required ---------------------------------------------------------------

# Where to deploy. Pick the region closest to your users: WebRTC media hairpins
# through this box, so region choice sets the floor on call latency.
region = "us-east-1"

# The hostname users will visit. Caddy requests a Let's Encrypt certificate for
# exactly this name, so its DNS A record must already point at the Elastic IP
# (see the `dns_record_instructions` output) before the first boot finishes.
domain_name = "chat.example.com"

# Git remote the instance clones the app from at boot. It must be reachable
# UNAUTHENTICATED from EC2 — user_data.sh.tftpl runs a bare `git clone` with no
# token, deploy key or credential helper. A private URL here does not fail the
# apply; it fails silently on the box, leaving no containers and no certificate.
# Verify before applying:
#   GIT_TERMINAL_PROMPT=0 git ls-remote <this-url> main
repo_url = "https://github.com/your-org/rxhive.git"

# --- Free Tier vs Paid plan --------------------------------------------------
#
# The defaults in variables.tf are sized for an AWS **Free plan** account
# (accountPlanType FREE, i.e. created on or after 2025-07-15). Such accounts
# REJECT non-eligible resources at apply time rather than billing for them:
#
#   instance_type              default m7i-flex.large  (2 vCPU / 8 GiB, x86_64)
#   db_instance_class          default db.t4g.micro    (2 vCPU / 1 GiB)
#   db_backup_retention_period default 1               (7 is rejected)
#
# Check which plan you are on:
#   aws freetier get-account-plan-state --region us-east-1
#
# On a **Paid plan** account, uncomment the block below to restore the original
# production sizing — notably 2 GiB of database RAM and 7 days of PITR:
#
# instance_type              = "t3.large"
# db_instance_class          = "db.t4g.small"
# db_backup_retention_period = 7

# --- Optional ---------------------------------------------------------------

# environment      = "prod"        # gates RDS deletion protection
# branch           = "main"
# db_allocated_storage = 20        # 20 GB is the gp3 minimum and the Free Tier figure

# Break-glass SSH. Left null, port 22 is closed entirely and you connect with
# SSM Session Manager instead (the instance role already allows it).
# ssh_allowed_cidr = "203.0.113.4/32"
